{
  "$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "recommended": true,
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "indentStyle": "space"
  },
  "html": {
    "formatter": {
      "selfCloseVoidElements": "always"
    }
  },
  "linter": {
    "includes": [
      "**",
      "!**/build/**",
      "!**/node_modules/**",
      "!**/dist/**"
    ],
    "rules": {
      "a11y": "on",
      "complexity": "on",
      "correctness": {
        "noNodejsModules": "off"
      },
      "performance": "on",
      "security": "on"
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": false,
    "useIgnoreFile": false
  }
}